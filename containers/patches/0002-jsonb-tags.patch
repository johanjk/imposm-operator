+// MakeJSONBString returns the element's tags as a JSON object (all tags,
+// or those listed in the include arg), for a JSONB column.
+func MakeJSONBString(columnName string, columnType ColumnType, column config.Column) (MakeValue, error) {
+	var include map[string]int
+	if _, ok := column.Args["include"]; ok {
+		var err error
+		include, err = decodeEnumArg(column, "include")
+		if err != nil {
+			return nil, err
+		}
+	}
+	jsonbString := func(val string, elem *osm.Element, geom *geom.Geometry, match Match) any {
+		tags := make(map[string]string, len(elem.Tags))
+		for k, v := range elem.Tags {
+			if include == nil || include[k] != 0 {
+				tags[k] = v
+			}
+		}
+		b, err := json.Marshal(tags) // keys sorted, so equal tags give equal values
+		if err != nil {
+			return "{}"
+		}
+		return string(b)
+	}
+	return jsonbString, nil
+}
