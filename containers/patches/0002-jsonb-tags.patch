+func TestJSONBString(t *testing.T) {
+	all, err := MakeJSONBString("tags", ColumnType{}, config.Column{Name: "tags", Type: "jsonb_tags"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	include, err := MakeJSONBString("tags", ColumnType{}, config.Column{
+		Name: "tags", Type: "jsonb_tags", Args: map[string]any{"include": []any{"key1", "key2"}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, test := range []struct {
+		column   MakeValue
+		tags     osm.Tags
+		expected string
+	}{
+		{all, osm.Tags{}, `{}`},
+		{all, osm.Tags{"key": "value"}, `{"key":"value"}`},
+		{all, osm.Tags{"b": "2", "a": "1"}, `{"a":"1","b":"2"}`},
+		{all, osm.Tags{`"key"`: `'"value"'`}, `{"\"key\"":"'\"value\"'"}`},
+		{all, osm.Tags{`\`: "Ümlåütê=>"}, `{"\\":"Ümlåütê=\u003e"}`},
+		{include, osm.Tags{"key": "value"}, `{}`},
+		{include, osm.Tags{"key": "value", "key2": "value"}, `{"key2":"value"}`},
+	} {
+		actual := test.column("", &osm.Element{Tags: test.tags}, nil, Match{})
+		if actual.(string) != test.expected {
+			t.Errorf("%s != %s for %#v", actual, test.expected, test.tags)
+		}
+	}
+}
