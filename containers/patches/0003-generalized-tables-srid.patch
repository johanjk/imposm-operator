--- /dev/null
+++ b/database/postgis/columns_test.go
@@ -0,0 +1,32 @@
+package postgis
+
+import (
+	"strings"
+	"testing"
+)
+
+// imposm3#309: generalized tables get the source's geometry type and SRID.
+func TestGeneralizedGeometryType(t *testing.T) {
+	for _, tc := range []struct {
+		geomType string
+		srid     int
+		want     string
+	}{
+		{"linestring", 3857, "geometry(LINESTRING, 3857)"},
+		{"point", 4326, "geometry(POINT, 4326)"},
+		{"polygon", 3857, "geometry(GEOMETRY, 3857)"},
+		{"geometry", 3857, "geometry(GEOMETRY, 3857)"},
+		{"", 3857, "geometry(GEOMETRY, 3857)"},
+	} {
+		spec := &GeneralizedTableSpec{Tolerance: 50, Source: &TableSpec{GeometryType: tc.geomType, Srid: tc.srid}}
+		if got := generalizedGeometryType(spec); got != tc.want {
+			t.Errorf("%q/%d: got %q, want %q", tc.geomType, tc.srid, got, tc.want)
+		}
+		col := &ColumnSpec{Name: "geometry"}
+		for _, typ := range []ColumnType{pgTypes["geometry"], pgTypes["validated_geometry"]} {
+			if sql := typ.GeneralizeSQL(col, spec); !strings.HasSuffix(sql, "::"+tc.want+` as "geometry"`) {
+				t.Errorf("%s: %s", typ.Name(), sql)
+			}
+		}
+	}
+}
