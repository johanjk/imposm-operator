+// generalizedGeometryType is the column type of a generalized table's
+// geometry: the source table's type and SRID (see addGeometryColumn), so the
+// CREATE TABLE AS of a generalized table registers it in geometry_columns
+// with its SRID instead of 0.
+func generalizedGeometryType(spec *GeneralizedTableSpec) string {
+	geomType := strings.ToUpper(spec.Source.GeometryType)
+	if geomType == "" || geomType == "POLYGON" {
+		geomType = "GEOMETRY" // for multipolygon support
+	}
+	return fmt.Sprintf("geometry(%s, %d)", geomType, spec.Source.Srid)
+}
