index 0000000..2d67842
--- /dev/null
+++ b/writer/relations_test.go
@@ -0,0 +1,25 @@
+package writer
+
+import (
+	"reflect"
+	"testing"
+
+	osm "github.com/omniscale/go-osm"
+)
+
+// imposm3#182: polygons from type=multipolygon relations do not carry the tag.
+func TestPolygonTags(t *testing.T) {
+	in := osm.Tags{"type": "multipolygon", "landuse": "railway"}
+	got := polygonTags(in)
+	if want := (osm.Tags{"landuse": "railway"}); !reflect.DeepEqual(got, want) {
+		t.Errorf("got %v, want %v", got, want)
+	}
+	if in["type"] != "multipolygon" {
+		t.Error("input tags changed")
+	}
+	for _, tags := range []osm.Tags{{"type": "boundary", "boundary": "administrative"}, {"landuse": "railway"}, {}} {
+		if got := polygonTags(tags); !reflect.DeepEqual(got, tags) {
+			t.Errorf("%v: got %v", tags, got)
+		}
+	}
+}
