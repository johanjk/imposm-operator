+
+// polygonTags are the tags a multipolygon relation's polygon is inserted
+// with: without type=multipolygon, which only says how the relation's members
+// form the polygon and means nothing for the polygon itself (imposm3#182).
+// Other relation types (type=boundary, ...) keep their tag. The relation was
+// matched with all its tags; r.Tags is not changed.
+func polygonTags(tags osm.Tags) osm.Tags {
+	if tags["type"] != "multipolygon" {
+		return tags
+	}
+	out := make(osm.Tags, len(tags)-1)
+	for k, v := range tags {
+		if k != "type" {
+			out[k] = v
+		}
+	}
+	return out
+}
diff --git a/writer/relations_test.go b/writer/relations_test.go
